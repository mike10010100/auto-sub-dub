# Hugging Face Token (Required for speaker diarization)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Ollama Configuration
# URL of your Ollama instance
OLLAMA_URL=http://192.168.86.172:11434

# Model to use for text translation (e.g. gemma4:26b)
# Using a model that supports 'thinking' (CoT) is recommended for syllable accuracy.
OLLAMA_MODEL=gemma4:26b

# Model to use for audio-informed emotion tagging (e.g. gemma4:e4b)
# This MUST be an E-variant model that accepts audio input.
OLLAMA_AUDIO_MODEL=gemma4:e4b

# Max out context length for long transcripts (e.g. 262144 for 256k)
OLLAMA_NUM_CTX=262144

# Device selection (optional: cuda, mps, cpu)
# If not set, the pipeline will auto-detect the best available device.
# DEVICE=mps
